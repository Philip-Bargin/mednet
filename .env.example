# Copy to .env for local development. Replace placeholders; never commit .env.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mednet
SPRING_DATASOURCE_USERNAME=mednet
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-only-password
MEDNET_ADMIN_EMAIL=admin@localhost.test
MEDNET_ADMIN_PASSWORD=replace-with-a-unique-local-password
SESSION_COOKIE_SECURE=false
# Used only by the MedNet API to send authentication messages directly through EKDSend.
EKDSEND_API_URL=https://es.ekddigital.com/api/v1
EKDSEND_API_KEY=replace-with-ekdsend-server-key
FROM_EMAIL=support@ekddigital.com
# Public web address used in verification and password-reset email links.
MEDNET_PUBLIC_URL=http://localhost:3000
# Optional Google OAuth sign-in. Use the deployed callback URL configured in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/login/oauth2/code/google
# Reverse proxies whose X-Forwarded-For names the client for rate limiting (addresses or CIDR ranges).
MEDNET_TRUSTED_PROXIES=
MEDNET_RATE_LIMIT_ENABLED=true
# Session idle timeout and absolute lifetime from sign-in.
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
