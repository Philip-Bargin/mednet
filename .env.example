# Copy to .env for local development. Replace placeholders; never commit .env.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mednet
SPRING_DATASOURCE_USERNAME=mednet
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-only-password
MEDNET_ADMIN_EMAIL=admin@localhost.test
MEDNET_ADMIN_PASSWORD=replace-with-a-unique-local-password
# Supabase Auth issuer and JWK endpoint are available in Project Settings > API.
SUPABASE_AUTH_ENABLED=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ISSUER_URI=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWK_SET_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Server-only Supabase secret key; never expose this to the web client.
SUPABASE_SECRET_KEY=replace-with-a-supabase-secret-key
SESSION_COOKIE_SECURE=false
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/callback/google
# Used only by the MedNet API to send authentication messages directly through EKDSend.
EKDSEND_API_URL=https://es.ekddigital.com/api/v1
EKDSEND_API_KEY=replace-with-ekdsend-server-key
FROM_EMAIL=support@ekddigital.com
# Public web address used in verification and password-reset email links.
NEXTAUTH_URL=http://localhost:3000
# Set these as public build/runtime variables for the Next.js web service.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-a-supabase-publishable-key
# Reverse proxies whose X-Forwarded-For names the client for rate limiting (addresses or CIDR ranges).
MEDNET_TRUSTED_PROXIES=
MEDNET_RATE_LIMIT_ENABLED=true
# Session idle timeout and absolute lifetime from sign-in.
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
